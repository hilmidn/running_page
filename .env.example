# Mapbox access token. Get one at https://www.mapbox.com/.
# Required for the default mapbox tile vendor. If left empty, the map will
# fall back to an empty token (map tiles won't render).
VITE_MAPBOX_TOKEN=

# MapTiler access token. Only required if MAP_TILE_VENDOR is set to "maptiler".
# VITE_MAPTILER_TOKEN=
